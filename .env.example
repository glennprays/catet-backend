ENV=development
APP_NAME=catet-backend
APP_PORT=3000

LOG_LEVEL=debug
LOG_OUTPUT=stdout

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=catet_dev
DB_NAME=catet_dev

DATABASE_URL=postgres://postgres:catet_dev@localhost:5432/catet_dev?sslmode=disable

# WhatsApp-OTP session auth (dev defaults; production must override both).
AUTH_SECRET=dev-only-secret
OWNER_PHONE=+628000000000
OTP_TTL_SECONDS=300

# WhatsApp gateway for OTP delivery. Empty URL = log sender (dev).
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Comma-separated list of allowed origins. Development should stay narrow;
# the app refuses to boot in production when this is "*".
CORS_ALLOWED_ORIGINS=http://localhost:3001
