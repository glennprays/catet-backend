ENV=development
APP_NAME=catet-backend
APP_PORT=3000

LOG_LEVEL=debug
LOG_OUTPUT=stdout

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=catet_dev
DB_NAME=catet_dev

DATABASE_URL=postgres://postgres:catet_dev@localhost:5432/catet_dev?sslmode=disable

# Integration tests truncate their schema, so they run against a
# separate database (created on demand). The harness refuses any name
# that does not end in `_test` — dev data is never at risk.
# Rebuild dev data any time with `make seed`.
TEST_DATABASE_URL=postgres://postgres:catet_dev@localhost:5432/catet_test?sslmode=disable

# Session auth (dev default; production must override AUTH_SECRET).
AUTH_SECRET=dev-only-secret
# One-time bootstrap claim: the phone that takes over the pre-seeded
# admin account on the next boot. Remove both vars after that boot —
# a claimed admin ignores them, and accounts are managed from
# Settings → Pengguna (or `catet user …`) from then on.
OWNER_PHONE=
# Optional companion of OWNER_PHONE: the admin's WhatsApp lid
# (GET <gateway>/contact/check?chat=…). Set it only when the gateway
# cannot resolve the lid itself.
OWNER_LID=
OTP_TTL_SECONDS=300

# Base URL of the dashboard. Invite and password-reset links the bot
# sends over WhatsApp are built from it, so it must be reachable by the
# people receiving them (production refuses the localhost default).
DASHBOARD_URL=http://localhost:3001

# WhatsApp gateway (glennprays/whatsapp-gateway). Empty URL = log sender:
# OTP codes and bot replies are printed to the API log (dev default).
#
# Setup with a real gateway:
#   1. POST /api/v1/register {"phone_number":"<bot number>","secret_key":"<SECRET_KEY>"}
#      → JWT for WA_GATEWAY_TOKEN. Raise the gateway's
#      JWT_TOKEN_DURATION_MINUTES first; the token is not auto-renewed.
#   2. Pair the number: POST /api/v1/login/qr_code/json and scan the QR.
#   3. Either set WA_WEBHOOK_URL (the API self-registers the subscription
#      at boot) or POST /api/v1/webhook {"url":…,"hmac_secret":…} by hand.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
# HMAC secret shared with the gateway subscription. Empty = the public
# webhook route is not registered at all.
WA_WEBHOOK_SECRET=
# Public URL of POST /api/v1/webhooks/whatsapp (empty = no self-registration).
WA_WEBHOOK_URL=

# OpenAI-compatible endpoint for category guessing / Source alias repair.
# Empty API key disables the LLM: captures land uncategorised in
# needs-review and unknown source aliases ask instead of guessing.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Also drives the intent router: corrections ("itu kategori makanan"),
# balance questions and free-form messages need it; without it those
# replies fall back to "Belum ngerti".
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
# Optional one-line rekap commentary (never contains numbers).
LLM_VERDICT_ENABLED=false
# Receipt photos are read by a separate, vision-capable model. Empty =
# reuse LLM_MODEL. Photos need a vision-capable model; glm-5.3-flash
# reads receipts, gpt-4o-mini does too. Reading one photo takes far
# longer than a category pick, hence its own timeout.
LLM_VISION_MODEL=
LLM_VISION_TIMEOUT_SECONDS=45

# Comma-separated list of allowed origins. Development should stay narrow;
# the app refuses to boot in production when this is "*".
CORS_ALLOWED_ORIGINS=http://localhost:3001

# The daily bill-reminder digest (ADR-0006): the only message the bot
# sends unprompted, and only for bills the user opted in per bill. Set
# false to silence it globally (e.g. a second API instance).
BILL_REMINDERS_ENABLED=true
